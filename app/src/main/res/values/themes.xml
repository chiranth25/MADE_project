<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.MADE_Project" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/accent_green</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/soft_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/soft_bg</item>
        <item name="materialCardViewStyle">@style/AppCardView</item>
        <item name="toolbarStyle">@style/AppToolbar</item>
    </style>

    <style name="Theme.MADE_Project" parent="Base.Theme.MADE_Project" />

    <style name="AppCardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
    </style>

    <style name="AppToolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">@color/text_primary</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
